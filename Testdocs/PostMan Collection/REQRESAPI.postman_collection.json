            "exec": [
              "//Status Code Validation\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 4️⃣ Validate Page Number\r",
              "pm.test(\"Page number is 2\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.page).to.eql(2);\r",
              "});\r",
              "// 2️⃣ Response Time Check\r",
              "pm.test(\"Response time is less than 800ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.above(800);\r",
              "});\r",
              "\r",
              "\r",
              "// 6️⃣ Validate Each User Has Required Fields\r",
              "pm.test(\"Each user has id, email, first_name, last_name, avatar\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    jsonData.data.forEach(function(user) {\r",
              "        pm.expect(user).to.have.property(\"id\");\r",
              "        pm.expect(user).to.have.property(\"email\");\r",
              "        pm.expect(user).to.have.property(\"first_name\");\r",
              "        pm.expect(user).to.have.property(\"last_name\");\r",
              "        pm.expect(user).to.have.property(\"avatar\");\r",
              "    });\r",
              "    });\r",
              "///execution of setNextRequest\r",
              "    pm.execution.setNextRequest(\"CreateUser\");\r",
              ""
